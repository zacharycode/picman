{
  "name": "picman",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "tauri dev",
    "desktop:build": "TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/picman-updater.key TAURI_SIGNING_PRIVATE_KEY_PASSWORD= tauri build",
    "release:github": "npm run desktop:build && npm run release:prepare",
    "release:prepare": "node scripts/prepare-github-release.mjs",
    "release:publish": "npm run release:github && node scripts/publish-github-release.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "stress:audit": "node scripts/performance-audit.mjs",
    "stress:create": "node scripts/create-stress-library.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
