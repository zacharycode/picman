{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picman.app/schemas/folder-metadata.v1.schema.json",
  "title": "Picman Folder Metadata v1",
  "type": "object",
  "required": ["version", "assets"],
  "properties": {
    "version": { "const": 1 },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "favorite": { "type": "boolean" },
          "note": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "sourceUrl": { "type": "string" },
          "capturedAt": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
